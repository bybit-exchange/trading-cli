{
  "name": "bybit-official-trading-cli",
  "version": "0.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Official Bybit V5 CLI for AI agents. 435 commands auto-generated from the OpenAPI spec, safety-first defaults, JSON I/O.",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "keywords": [
    "bybit",
    "trading",
    "cli",
    "crypto",
    "exchange",
    "ai-agent",
    "claude-code",
    "openclaw"
  ],
  "bin": {
    "trading-cli": "dist/index.js",
    "bybit-official-trading-cli": "dist/index.js",
    "bybit-cli": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bybit-exchange/trading-cli.git"
  },
  "files": [
    "dist",
    "skill",
    "scripts/postinstall.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "update-notifier": "^7.3.1",
    "yargs": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/update-notifier": "^6.0.8",
    "@types/yargs": "^17.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=20.6"
  }
}
